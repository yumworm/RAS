{
  "name": "RollAStream",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Modules": {
        "$path": "src/ReplicatedStorage/Modules"
      },
      "Assets": {
        "$className": "Folder",
        "Presentation": {
          "$className": "Folder",
          "Particles": { "$className": "Folder" },
          "StandardBanners": { "$className": "Folder" },
          "FlagshipBanners": { "$className": "Folder" },
          "Audio": {
            "$className": "Folder",
            "RarityChimes": { "$className": "Folder" },
            "Flagship": { "$className": "Folder" }
          },
          "Animations": { "$className": "Folder" }
        }
      },
      "Remotes": {
        "$className": "Folder",
        "ClientReady": { "$className": "RemoteEvent" },
        "SpinRequest": { "$className": "RemoteEvent" },
        "SpinResult": { "$className": "RemoteEvent" },
        "InitialState": { "$className": "RemoteEvent" },
        "StateUpdate": { "$className": "RemoteEvent" },
        "RequestDonationPrompt": { "$className": "RemoteEvent" },
        "DonationPromptResult": { "$className": "RemoteEvent" },
        "RequestGlobalDonorLeaderboard": { "$className": "RemoteEvent" },
        "GlobalDonorLeaderboardUpdated": { "$className": "RemoteEvent" },
        "DonationNotification": { "$className": "RemoteEvent" },
        "DonationStandEffect": { "$className": "RemoteEvent" },
        "OpenDonationPanel": { "$className": "RemoteEvent" }
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Server": {
        "$path": "src/ServerScriptService"
      }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$path": "src/StarterPlayer/StarterPlayerScripts"
      }
    }
  }
}
